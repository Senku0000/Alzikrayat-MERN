# Copy this file to ".env" and fill in your real values.
# .env itself must NEVER be committed to Git (see .gitignore).

# Local MongoDB instance:
MONGODB_URI=mongodb://127.0.0.1:27017/alzikrayat

# Or a MongoDB Atlas connection string, e.g.:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/alzikrayat

PORT=5000
